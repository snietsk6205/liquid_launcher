<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 0.15.3 (D196): the board camera. Optional: a phone without one still runs the launcher. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <!-- 0.15.3 (D196): board photos, several in a row, each saved in Pictures/ESSAI/<class>. -->
        <activity
            android:name="dev.liquid.launcher.feature.home.BoardCameraActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!--
            0.16.0 (D207): a video wallpaper as the phone's live wallpaper too (lock screen, recents), set only by the user in
            Android's own screen. Its own process: decoding there can never slow the redirect or the home screen.
        -->
        <service
            android:name="dev.liquid.launcher.feature.home.LiquidVideoWallpaperService"
            android:exported="true"
            android:label="Liquid video wallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:process=":wallpaper">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/liquid_video_wallpaper" />
        </service>
    </application>
</manifest>
